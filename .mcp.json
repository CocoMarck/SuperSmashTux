{
  "mcpServers": {
    "godot": {
      "command": "npx",
      "args": ["@coding-solo/godot-mcp"],
      "env": {
        "GODOT_PATH": "D:\\Godot\\Godot_v4.7.1-stable_mono_win64.exe"
      }
    },
    "blender": {
      "command": "uvx",
      "args": [
        "--refresh",
        "--with",
        "mcp[cli]<2",
        "--from",
        "git+https://projects.blender.org/lab/blender_mcp.git#subdirectory=mcp",
        "blender-mcp"
      ],
      "env": {
        "BLENDER_MCP_HOST": "localhost",
        "BLENDER_MCP_PORT": "9876",
        "BLENDER_PATH": "C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe"
      }
    }
  }
}
